#!/usr/bin/with-contenv bashio
#
# Checks the install, then hands over to `fetchit serve`, which keeps the
# schedule and serves the panel. Restarting the add-on picks up a changed
# schedule. The times are local: Supervisor gives the container the same
# timezone as Home Assistant.

set -e

bashio::log.info "Checking the install..."
(
    # shellcheck source=../../../../usr/local/lib/fetchit-env.sh
    source /usr/local/lib/fetchit-env.sh
    fetchit doctor 2>&1
) | while IFS= read -r line; do
    bashio::log.info "  ${line}"
done || true

# From here on `fetchit serve` does it all: it runs at the scheduled times
# (upgrading yt-dlp first, once a day, if `update_yt_dlp` says so) and serves
# the panel in Home Assistant's sidebar, with buttons to run now.
# shellcheck source=../../../../usr/local/lib/fetchit-env.sh
source /usr/local/lib/fetchit-env.sh

if [ -z "${FETCHIT_SCHEDULE}" ]; then
    bashio::log.warning "No times in 'schedule': fetchit runs only when asked, from the panel."
else
    bashio::log.info "Schedule: ${FETCHIT_SCHEDULE} (${TZ:-system timezone})"
fi

exec fetchit serve \
    --host 0.0.0.0 \
    --port 8099 \
    --on-start "$(bashio::config 'on_start')"
