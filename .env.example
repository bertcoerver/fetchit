# Copy this file to `.env` and fill in what you need. `.env` is git-ignored.

# Where the library is. Optional; defaults to the config's "library", then ~/fetchit.
# FETCHIT_LIBRARY=~/fetchit

# The config file. Optional; defaults to fetchit.json in the current folder.
# FETCHIT_CONFIG=fetchit.json

# Where tracebacks and run boundaries are logged. Optional; defaults to
# fetchit.log in the current folder.
# FETCHIT_LOG=~/Library/Logs/fetchit.log

# Only if YouTube starts answering "Sign in to confirm you're not a bot".
# A browser you are logged into (optionally `browser:profile`), or a cookies.txt
# export. The file wins if both are set. Use a throwaway Google account.
# FETCHIT_YOUTUBE_COOKIES_FROM_BROWSER=firefox
# FETCHIT_YOUTUBE_COOKIES=~/.config/fetchit/youtube-cookies.txt
